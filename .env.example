# Base .env (gitignored). Holds secret/host-specific config. Copy to .env and fill in.

# --- Backend ---------------------------------------------------------------
NODE_ENV=development
PORT=8080

# Postgres (matches docker-compose).
DATABASE_URL=postgresql://aivo:aivo@localhost:5532/aivo

# --- Discord ---------------------------------------------------------------
# Bot token from the Discord Developer Portal (Bot -> Reset Token). Secret.
DISCORD_BOT_TOKEN=
# Application (client) id of the Discord app.
DISCORD_APP_ID=
# The private guild (server) the bot listens in; messages elsewhere are ignored.
DISCORD_GUILD_ID=
# Your own Discord user id — marks the is_owner user on JIT provisioning.
OWNER_DISCORD_USER_ID=
# Channel where Aivo responds to all messages. In other channels Aivo only
# responds when mentioned or when replying to a thread Aivo started.
# Right-click the channel in Discord → Copy Channel ID.
DISCORD_HOME_CHANNEL_ID=

# On startup Aivo replies to messages it missed while offline. If a missed
# message is older than this many minutes, the reply is prefixed with a short
# note that Aivo was offline (so a late reply is explained). Default 15.
OFFLINE_ACK_THRESHOLD_MINUTES=15
