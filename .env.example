# Base .env (gitignored). Holds secret/host-specific config. Copy to .env and fill in.

# --- Backend ---------------------------------------------------------------
NODE_ENV=development
PORT=8080

# Postgres (matches docker-compose).
DATABASE_URL=postgresql://aivo:aivo@localhost:5532/aivo

# --- Discord ---------------------------------------------------------------
# Bot token from the Discord Developer Portal (Bot -> Reset Token). Secret.
DISCORD_BOT_TOKEN=
# Application (client) id of the Discord app.
DISCORD_APP_ID=
# The private guild (server) the bot listens in; messages elsewhere are ignored.
DISCORD_GUILD_ID=
# Your own Discord user id — marks the is_owner user on JIT provisioning.
OWNER_DISCORD_USER_ID=
# Channel where Aivo responds to all messages. In other channels Aivo only
# responds when mentioned or when replying to a thread Aivo started.
# Right-click the channel in Discord → Copy Channel ID.
DISCORD_HOME_CHANNEL_ID=

# The #youtube channel for the daily digest + feedback (Aivo answers everything
# there too). Optional: unset delivers digests to the home channel.
DISCORD_YOUTUBE_CHANNEL_ID=

# On startup Aivo replies to messages it missed while offline. If a missed
# message is older than this many minutes, the reply is prefixed with a short
# note that Aivo was offline (so a late reply is explained). Default 15.
OFFLINE_ACK_THRESHOLD_MINUTES=15

# --- YouTube (daily digest) --------------------------------------------------
# OAuth client for the single owner-connected YouTube account whose subscriptions
# feed the digest (Google Cloud Console -> APIs & Services -> Credentials, with the
# YouTube Data API v3 enabled). All of CLIENT_ID/CLIENT_SECRET/REFRESH_TOKEN must be
# set for the digest to run; until then the scheduler stays idle and everything else
# works. Mint the refresh token once: set the CLIENT_ID/SECRET + REDIRECT_URL, open
# /youtube/oauth/start, approve with the owner's Google account, and copy the token
# the callback page shows into YOUTUBE_OAUTH_REFRESH_TOKEN. Secrets.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=
# Public URL of the OAuth callback, registered on the Google client
# (e.g. https://aivo.homectl.no/youtube/oauth/callback or http://localhost:8080/... locally).
YOUTUBE_OAUTH_REDIRECT_URL=

# --- LLM (Scaleway / OpenAI-compatible) ------------------------------------
# API key for the inference provider, sent as the OpenAI `Authorization: Bearer`
# token. For Scaleway this is your IAM API *Secret Key* (the long secret value) —
# NOT the Access Key (the SCWxxxx... identifier). The key's IAM principal must
# hold the GenerativeApisFullAccess or GenerativeApisModelAccess permission set,
# or queries return 403 FORBIDDEN. Set a hard spend limit on the key in the
# provider dashboard as a backstop. Secret.
LLM_API_KEY=
# OpenAI-compatible endpoint base URL. For Scaleway's generative APIs this is
# https://api.scaleway.ai/v1 (see https://www.scaleway.com/en/generative-apis/).
# If your key only has access to a specific Project, use the project-scoped form
# instead: https://api.scaleway.ai/{project_id}/v1
LLM_BASE_URL=https://api.scaleway.ai/v1
# NOTE: model ids + prices are NOT set here — they live in the model_pricing
# table (seeded with PLACEHOLDER ids/prices) so the owner can swap models and
# refresh prices from chat. Ask the agent (as owner) to set them to the real
# Scaleway model ids/prices, or a chat turn fails on an unknown-model error.

# Upper bound on completion tokens per call (also the approval-gate output estimate).
LLM_MAX_OUTPUT_TOKENS=1024
# Hard cap on tool round-trips per agent turn (runaway backstop).
AGENT_MAX_TOOL_ITERATIONS=5
# How many recent messages of history to feed the agent as context.
AGENT_CONTEXT_MESSAGE_LIMIT=30
# A pending approval-gate prompt older than this (minutes) is swept to expired.
APPROVAL_TTL_MINUTES=60

# --- Dashboard auth (homectl-auth sidecar; phase 3) -------------------------
# Aivo runs behind the homectl-auth-proxy sidecar in prod
# (homectl-auth docs/sidecar/integration.md): the sidecar runs the OAuth flow and
# injects verified X-Homectl-* identity headers, so the app does no auth work and
# needs NONE of the OAuth config here — PUBLIC_AUTH_URL, AUTH_CLIENT_ID/SECRET,
# COOKIE_KEY, APP_BASE_URL, etc. all live on the *sidecar* container (see
# k8s/deployment.yml).
# AUTH_MODE / VITE_DISABLE_AUTH live in the committed overlays (.env.development,
# .env.sidecar), not here. Unset, AUTH_MODE derives from NODE_ENV
# (prod -> sidecar; anything else -> dev).
# Directory of the built dashboard SPA. Set by the Docker image (/app/web);
# leave unset in dev — Vite serves the frontend on :3000 and proxies the API.
# WEB_ROOT=
