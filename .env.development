# Committed dev overlay, selected by `pnpm dev`. No secrets — secret/host-specific
# values (DISCORD_BOT_TOKEN, DATABASE_URL, ...) live in the gitignored root .env.
NODE_ENV=development
LOG_LEVEL=debug
# Dashboard auth: offline fixed dev principal; SPA skips the token bootstrap.
AUTH_MODE=dev
VITE_DISABLE_AUTH=true
