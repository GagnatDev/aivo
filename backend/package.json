{
  "name": "@aivo/backend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "aivo-backend": "dist/server.js"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env --env-file-if-exists=../.env.development src/server.ts",
    "dev:sidecar": "tsx watch --env-file-if-exists=../.env --env-file-if-exists=../.env.sidecar src/server.ts",
    "build": "tsc --noEmit && tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "start": "node dist/server.js",
    "migrate": "node-pg-migrate",
    "db:codegen": "tsx scripts/codegen.ts",
    "db:codegen:check": "tsx scripts/codegen.ts --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "express": "^5.3.0",
    "kysely": "^0.29.7",
    "node-cron": "^4.6.0",
    "node-pg-migrate": "^9.0.0",
    "openai": "^7.38.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "kysely-codegen": "^0.20.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  }
}
