# Committed overlay for running aivo in sidecar auth mode, selected by
# `pnpm dev:sidecar`. AUTH_MODE=sidecar makes the backend read the X-Homectl-*
# identity headers the homectl-auth-proxy injects, and the SPA becomes
# auth-agnostic (no dev bypass). This only works with the sidecar actually in
# front of the app — see the guide's "Option B" (DEV_FAKE_IDENTITY) in
# homectl-auth docs/sidecar/integration.md §7. For plain offline dev without a
# sidecar, use `pnpm dev` (AUTH_MODE=dev). No secrets here.
NODE_ENV=development
LOG_LEVEL=debug
AUTH_MODE=sidecar
VITE_DISABLE_AUTH=false
