{
  "name": "aivo",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:sidecar": "pnpm -r --parallel run dev:sidecar",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "dev:backend": "pnpm --filter @aivo/backend run dev",
    "dev:frontend": "pnpm --filter @aivo/frontend run dev"
  }
}
